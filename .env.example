# Hadrian³ — example environment. Copy to .env and adjust.
# .env is never committed.

# --- Postgres (docker compose service "db") ---
POSTGRES_USER=hadrian3
POSTGRES_PASSWORD=hadrian3
POSTGRES_DB=hadrian3

# --- Backend ---
# Inside the compose network the database host is "db". For local runs without
# Docker, use the URL printed by backend/scripts/dev_db.sh.
DATABASE_URL=postgresql+psycopg://hadrian3:hadrian3@db:5432/hadrian3

# Workbook to import. Defaults to the synthetic sample shipped in samples/,
# so a fresh clone works without any private data. Point this at your own
# workbook to import real backtests.
XLSX_PATH=/data/samples/backtesting_repository_sample.xlsx

# Boundary between in-sample and out-of-sample. Trades before this date are IS,
# trades on or after it are OOS.
IS_OOS_SPLIT_DATE=2024-01-01

# --- Optional: upstream research engines ---
# Result directories consumed by POST /import/programmatic. Leave empty if you
# do not have them; the endpoint then reports nothing to import. See
# docker-compose.override.example.yml for mounting them into the container.
HADRIAN2_RESULTS_DIR=
HADRIAN_ENGINE_RESULTS_DIR=

# --- Frontend ---
# Leave empty: the browser then uses the page's own hostname at runtime
# (lib/api.ts), which works on localhost and on any LAN IP without a rebuild.
NEXT_PUBLIC_API_URL=
